{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@payload-config": ["./payload.config.ts"],
      "payload-workflows": ["../src/index.ts"],
      "payload-workflows/*": ["../src/exports/*.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../src/**/*.ts", "../src/**/*.tsx", ".next/types/**/*.ts", "next-env.d.ts"],
  "exclude": ["node_modules", ".next"]
}
